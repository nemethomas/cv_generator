# Sensitive / Private Daten & Dokumente (Beispieldateien werden versioniert)
docs/**/*
!docs/**/
!docs/README.md
!docs/**/.gitkeep

jobs/**/*
!jobs/**/
!jobs/example.md
!jobs/**/.gitkeep

src/**/*
!src/**/
!src/cv-example.md
!src/letter-example.md
!src/**/.gitkeep

# Generierte Build-Artefakte
dist/**/*
!dist/**/
!dist/**/.gitkeep

# macOS Metadaten
.DS_Store
.AppleDouble
.LSOverride
._*
**/.DS_Store

# Node / Tooling Abhängigkeiten
node_modules/
.opencode/node_modules/

# LaTeX Hilfs- und Logdateien (falls direkt erzeugt)
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.cache_jobs.json
.cache_jobs.json

# Editor & IDE Konfigurationen
.vscode/
.idea/
